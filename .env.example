# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored; this file is not.
# ---------------------------------------------------------------------------

PORT=3000

# Where the SQLite database and cached artwork live (a mounted volume).
DATA_DIR=/config

# Completed downloads, AS THIS CONTAINER SEES THEM.
DOWNLOAD_ROOT=/downloads/complete

# Jellyfin anime library root, AS THIS CONTAINER SEES IT.
# Must be on the same filesystem as DOWNLOAD_ROOT — we hardlink between them.
LIBRARY_ROOT=/media/anime

# Completed downloads, AS QBITTORRENT SEES THEM. qBittorrent reports paths in
# its own container's namespace; we rewrite this prefix to DOWNLOAD_ROOT.
# Keep it identical to DOWNLOAD_ROOT if both containers mount the same path.
QB_DOWNLOAD_ROOT=/downloads/complete

# --- qBittorrent -----------------------------------------------------------
QBITTORRENT_URL=http://host.docker.internal:8080
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=changeme
QBITTORRENT_CATEGORY=haro-anime

# --- Jellyfin --------------------------------------------------------------
# How THIS CONTAINER reaches Jellyfin.
JELLYFIN_URL=http://host.docker.internal:8096
JELLYFIN_API_KEY=changeme
JELLYFIN_USER_ID=changeme

# How a BROWSER reaches Jellyfin — used to build "Play" links.
# host.docker.internal above resolves only inside the container, so it cannot
# be used for links. Leave this empty and the UI assumes Jellyfin is on the
# same host you opened Haro from, at port 8096 (correct for a single Pi).
# Set it when Jellyfin lives elsewhere or sits behind a domain, e.g.
#   JELLYFIN_PUBLIC_URL=https://jellyfin.example.com
JELLYFIN_PUBLIC_URL=

# --- Upstream data sources -------------------------------------------------
ANIMEGARDEN_API=https://api.animes.garden
BANGUMI_API=https://api.bgm.tv
# bgm.tv asks for a descriptive User-Agent identifying your deployment.
BANGUMI_USER_AGENT=haro-anime-bot/0.1 (self-hosted)

# --- Scheduling ------------------------------------------------------------
# How often to check subscriptions for new episodes.
POLL_INTERVAL_MINUTES=15
# How often to poll qBittorrent for download progress.
MONITOR_INTERVAL_SECONDS=60

# AnimeGarden timestamps and Bangumi air dates are CST-oriented; leaving this
# as UTC shifts the airing calendar by a day.
TZ=Asia/Shanghai
